<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <title>Detech | Reporte de Anomalías</title>
  <!-- Usar Bricolage Grotesque, Inter y JetBrains Mono -->
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    /* ── Base ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --canvas: #f9f7f3;
      --surface-bone: #f3f0e8;
      --surface-card: #ffffff;
      --surface-dark: #202020;
      --surface-deep: #000000;
      --ink: #202020;
      --charcoal: #575757;
      --primary: #ea2804;
      --critical: #ea2804;
      --warning: #f59e0b;
      --info: #3b82f6;
      --hairline: rgba(32,32,32,0.12);
      
      --font-display: 'Bricolage Grotesque', sans-serif;
      --font-body: 'Inter', sans-serif;
      --font-code: 'JetBrains Mono', monospace;
    }

    @page { size: A4; margin: 20mm 15mm; }

    body {
      font-family: var(--font-body);
      background: var(--canvas);
      color: var(--ink);
      font-size: 14px;
      line-height: 1.5;
      padding: 24px;
    }

    code {
      font-family: var(--font-code);
      font-size: 0.9em;
      background: var(--surface-bone);
      padding: 2px 6px;
      border-radius: 4px;
    }

    /* ── Header ── */
    .report-header {
      background: var(--surface-dark);
      color: #fcfcfc;
      border-radius: 10px;
      padding: 32px 40px;
      margin-bottom: 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .report-logo-text h1 {
      font-family: var(--font-display);
      font-size: 48px;
      font-weight: 700;
      letter-spacing: -1px;
      line-height: 1.0;
    }

    .report-meta {
      text-align: right;
      font-size: 12px;
      color: rgba(252,252,252,0.72);
      line-height: 1.6;
    }

    /* ── Summary Grid ── */
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 32px;
    }

    .stat-card {
      background: var(--surface-card);
      border: 1px solid var(--hairline);
      border-radius: 16px;
      padding: 24px;
    }

    .stat-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--charcoal);
      margin-bottom: 8px;
    }

    .stat-value {
      font-family: var(--font-display);
      font-size: 48px;
      font-weight: 700;
      line-height: 1.0;
      color: var(--ink);
    }
    
    .critical .stat-value { color: var(--critical); }
    .warning  .stat-value { color: var(--warning); }
    .info     .stat-value { color: var(--info); }

    /* ── Sections ── */
    .section-title {
      font-family: var(--font-display);
      font-size: 30px;
      font-weight: 600;
      letter-spacing: -0.5px;
      margin-bottom: 16px;
      border-bottom: 2px solid var(--primary);
      padding-bottom: 8px;
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 32px;
    }

    .category-chip {
      background: var(--surface-bone);
      border-radius: 6px;
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .category-name {
      font-size: 14px;
      font-weight: 600;
      color: var(--charcoal);
    }

    .category-count {
      font-family: var(--font-code);
      font-size: 16px;
      font-weight: 600;
      color: var(--ink);
    }

    /* ── File Results ── */
    .file-section {
      background: var(--surface-card);
      border: 1px solid var(--hairline);
      border-radius: 10px;
      padding: 20px;
      margin-bottom: 24px;
      page-break-inside: avoid;
    }

    .file-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .file-name {
      font-family: var(--font-code);
      font-size: 14px;
      font-weight: 500;
    }

    .badge {
      display: inline-flex;
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 600;
      margin-left: 8px;
      background: var(--surface-bone);
      color: var(--ink);
    }
    
    .badge-critical { background: var(--critical); color: #fff; }
    .badge-warning  { background: var(--warning); color: #fff; }
    .badge-info     { background: var(--info); color: #fff; }

    /* ── Table ── */
    .anomaly-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }

    .anomaly-table th {
      text-align: left;
      padding: 8px;
      border-bottom: 1px solid var(--hairline);
      color: var(--charcoal);
      font-weight: 600;
    }

    .anomaly-table td {
      padding: 12px 8px;
      border-bottom: 1px solid var(--hairline);
      vertical-align: top;
    }

    .anomaly-table tr:last-child td { border-bottom: none; }
    
    .col-line, .col-rule, .col-context {
      font-family: var(--font-code);
      font-size: 12px;
    }
    .col-line { color: var(--charcoal); }

    /* ── Footer ── */
    .report-footer {
      margin-top: 48px;
      padding: 24px;
      background: var(--surface-deep);
      color: rgba(252,252,252,0.72);
      font-size: 12px;
      text-align: center;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <div class="report-header">
    <div class="report-logo-text">
      <h1>DETECH</h1>
    </div>
    <div class="report-meta">
      <div><strong>Generado:</strong> {{ generated_at }}</div>
      <div><strong>Archivos:</strong> {{ summary.total_files }}</div>
      <div><strong>Anomalías:</strong> {{ summary.total_anomalies }}</div>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="summary-grid">
    <div class="stat-card">
      <div class="stat-label">Archivos</div>
      <div class="stat-value">{{ summary.total_files }}</div>
    </div>
    <div class="stat-card critical">
      <div class="stat-label">Críticos</div>
      <div class="stat-value">{{ summary.critical }}</div>
    </div>
    <div class="stat-card warning">
      <div class="stat-label">Advertencias</div>
      <div class="stat-value">{{ summary.warning }}</div>
    </div>
    <div class="stat-card info">
      <div class="stat-label">Info</div>
      <div class="stat-value">{{ summary.info }}</div>
    </div>
  </div>

  <!-- Category Breakdown -->
  {% if categories %}
  <div style="margin-bottom: 32px;">
    <div class="section-title">Desglose por Categoría</div>
    <div class="category-grid">
      {% for cat, anomalies in categories.items() %}
      <div class="category-chip">
        <span class="category-name">{{ cat_labels.get(cat, cat) }}</span>
        <span class="category-count">{{ anomalies|length }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- File Results -->
  <div class="section-title">Detalle por Archivo</div>

  {% for file in files %}
  <div class="file-section">
    <div class="file-header">
      <div class="file-name">📄 {{ file.filepath }}</div>
      <div>
        <span class="badge">{{ file.total_lines }} líneas</span>
        {% if file.critical > 0 %}<span class="badge badge-critical">{{ file.critical }} Crítico</span>{% endif %}
        {% if file.warning  > 0 %}<span class="badge badge-warning">{{ file.warning }} Adv</span>{% endif %}
        {% if file.info     > 0 %}<span class="badge badge-info">{{ file.info }} Info</span>{% endif %}
        {% if file.anomaly_count == 0 %}<span class="badge" style="background:var(--badge-success);color:#fff">✓ Sin anomalías</span>{% endif %}
      </div>
    </div>

    {% if file.anomalies %}
    <table class="anomaly-table">
      <thead>
        <tr>
          <th>Línea</th>
          <th>Regla</th>
          <th>Severidad</th>
          <th>Descripción</th>
          <th>Contexto</th>
        </tr>
      </thead>
      <tbody>
        {% for a in file.anomalies %}
        <tr>
          <td class="col-line">#{{ a.line }}</td>
          <td class="col-rule">{{ a.rule_id }}</td>
          <td>
            <span class="badge badge-{{ 'critical' if a.severity == 'critical' else 'warning' if a.severity == 'warning' else 'info' }}">
              {{ 'Crítico' if a.severity == 'critical' else 'Advertencia' if a.severity == 'warning' else 'Info' }}
            </span>
          </td>
          <td class="col-message">{{ a.message }}</td>
          <td class="col-context">{{ a.context if a.context else '—' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div style="text-align:center; padding:16px; color:var(--charcoal)">No se detectaron anomalías en este archivo.</div>
    {% endif %}
  </div>
  {% endfor %}

  <!-- Footer -->
  <div class="report-footer">
    DETECH v0.1.0 — Herramienta de Detección Estática de Anomalías en Código Python <br>
    Generado el {{ generated_at }}
  </div>

</body>
</html>
